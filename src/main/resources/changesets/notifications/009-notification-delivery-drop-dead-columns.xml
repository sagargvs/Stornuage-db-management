<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="notifications-009-drop-retry-count" author="stornuage">
        <comment>
            Drop retry_count from notification_delivery_log. The column has been in the
            schema since inception but nothing in the delivery path ever writes a value
            other than the default 0. FCM retries are handled inline by FcmClient and
            do not surface as separate delivery_log rows, so the column has no readers.
        </comment>
        <dropColumn tableName="notification_delivery_log" schemaName="stornuage_notifications"
                    columnName="retry_count"/>

        <rollback>
            <addColumn tableName="notification_delivery_log" schemaName="stornuage_notifications">
                <column name="retry_count" type="INT" defaultValueNumeric="0">
                    <constraints nullable="false"/>
                </column>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
