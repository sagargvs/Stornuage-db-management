<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="integration-001-create-schema" author="stornuage">
        <sql>CREATE SCHEMA IF NOT EXISTS integration;</sql>
        <sql>CREATE EXTENSION IF NOT EXISTS "pgcrypto";</sql>
        <rollback>
            <sql>DROP SCHEMA IF EXISTS integration CASCADE;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
