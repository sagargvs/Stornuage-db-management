<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="nutritionmeter-007-nutrition-summary" author="stornuage">
        <createTable tableName="nutrition_summary" schemaName="nutritionmeter">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="period_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="total_events" type="INT" defaultValueNumeric="0"/>
            <column name="total_weight_g" type="NUMERIC(12,2)" defaultValueNumeric="0"/>
            <column name="total_calories" type="NUMERIC(12,2)" defaultValueNumeric="0"/>
            <column name="total_protein_g" type="NUMERIC(10,2)" defaultValueNumeric="0"/>
            <column name="total_carbohydrates_g" type="NUMERIC(10,2)" defaultValueNumeric="0"/>
            <column name="total_fat_g" type="NUMERIC(10,2)" defaultValueNumeric="0"/>
            <column name="total_fiber_g" type="NUMERIC(10,2)" defaultValueNumeric="0"/>
            <column name="total_iron_mg" type="NUMERIC(10,2)" defaultValueNumeric="0"/>
            <column name="total_calcium_mg" type="NUMERIC(10,2)" defaultValueNumeric="0"/>
            <column name="category_breakdown" type="JSONB" defaultValue="{}"/>
            <column name="item_breakdown" type="JSONB" defaultValue="[]"/>
            <column name="calculated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="nutrition_summary" schemaName="nutritionmeter"
                             columnNames="customer_id, period_type, period_start"
                             constraintName="uq_summary_customer_period"/>

        <createIndex indexName="idx_summary_customer_period" tableName="nutrition_summary" schemaName="nutritionmeter">
            <column name="customer_id"/>
            <column name="period_type"/>
            <column name="period_start" descending="true"/>
        </createIndex>

        <rollback>
            <dropTable tableName="nutrition_summary" schemaName="nutritionmeter"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
